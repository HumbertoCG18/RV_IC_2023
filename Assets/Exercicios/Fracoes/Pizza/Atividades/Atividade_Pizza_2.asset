  _audioDescricao:
    _descricao: "Para o jantar temos uma pizza de calabresa e uma pizza de mussarela.
      As pizzas foram divididas em 5 partes iguais. Se comermos 2 peda\xE7os da pizza
      de calabresa e 1 peda\xE7o da pizza de mussarela, qual fra\xE7\xE3o das pizzas
      comeremos?"
    _descricaoVozMasculina: {fileID: 8300000, guid: cadc6bb46c8f2bf47afa317db881e8d6, type: 3}
    _descricaoVozFeminina: {fileID: 8300000, guid: 48093aee3e607ea4dbf30a4c0c70fa91, type: 3}
  _fracoesDesejadasLadoEsquerdo:
  - _fracao:
      _numerador: 2
      _denominador: 5
    _mostrarPedacosComidos: 1
  - _fracao:
      _numerador: 1
      _denominador: 5
    _mostrarPedacosComidos: 1
  _fracoesDesejadasLadoDireito:
